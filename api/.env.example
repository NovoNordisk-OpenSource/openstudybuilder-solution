# Application Settings
APP_NAME="OpenStudyBuilder API"
UVICORN_ROOT_PATH="/"
APP_DEBUG=false
COLOR_LOGS=true
UID=1000
NUMBER_OF_UID_DIGITS=6

# Database Settings
NEO4J_DATABASE="neo4j"
# NEO4J_MDR_AUTH_PASSWORD is required by compose (compose.yaml fails fast if unset)
# and is interpolated into NEO4J_AUTH for the database container and into the
# default NEO4J_DSN below.
NEO4J_MDR_AUTH_PASSWORD="<your-neo4j-password>"
# If db/init_neo4j.py has provisioned the least-privileged `mdr` role (Enterprise only —
# see db/README.md), point this at NEO4J_MDR_ROLE_USER instead of the admin user.
NEO4J_DSN="bolt://neo4j:<your-neo4j-password>@localhost:7687/neo4j"
NEO4J_CONNECTION_LIFETIME=1740
NEO4J_LIVENESS_CHECK_TIMEOUT=300

# Standards Import API (port 8010) — CDISC staging database.
# Durable and owned by the standards import app: analysing a new package needs the
# state left by the previously imported ones. Same DSN format as NEO4J_DSN.
# When unset, NEO4J_DSN is used.
# If db/init_neo4j.py has provisioned the least-privileged `staging` role (Enterprise
# only — see db/README.md), point this at NEO4J_STAGING_ROLE_USER instead of the admin
# user — the staging role can see :CDISCStaging nodes and nothing else.
STANDARDS_IMPORT_STAGING_DSN="bolt://neo4j:<your-neo4j-password>@localhost:7687/cdisc-import"

# Standards import API — discovering which CDISC releases have been published. Unset,
# the discovery endpoint refuses rather than reporting an empty list, and uploading
# package files by hand works exactly as before. The CDISC Library API key is not
# configured here: each user supplies their own when they click "Fetch new releases
# from CDISC", and it is never stored.
STANDARDS_IMPORT_CDISC_API_BASE_URL=
# Optional.
# STANDARDS_IMPORT_CDISC_API_TIMEOUT_SECONDS=30

# Standards import API — the optional semantic duplicate check. Unset, it does not run
# and the rest of the sponsor impact assessment works exactly as it does now. See
# "Adapting the semantic check to your own LLM backend" in standards_import/README.md
# before pointing this at a gateway of your own.
STANDARDS_IMPORT_SEMANTIC_PROVIDER=standards_import.services.semantic_provider:http_chat_provider
STANDARDS_IMPORT_SEMANTIC_GATEWAY_URL=
STANDARDS_IMPORT_SEMANTIC_API_KEY=
STANDARDS_IMPORT_SEMANTIC_MODEL=
# Optional, with the defaults the measured prompt was run at.
# STANDARDS_IMPORT_SEMANTIC_TIMEOUT_SECONDS=900
# STANDARDS_IMPORT_SEMANTIC_MAX_TOKENS=16000
MAX_PACKAGE_FILE_BYTES=67108864
STAGING_BATCH_SIZE=1000

# Cache Settings
CACHE_MAX_SIZE=1000
CACHE_TTL=3600

# Security & CORS
ALLOW_ORIGIN_REGEX=".*"
ALLOW_CREDENTIALS=true
ALLOW_METHODS="*"
ALLOW_HEADERS="*"

# Standards Import API — set to false to run the main app without SI's routers
# (useful when standards-import is deployed as a separate process on its own port).
STANDARDS_IMPORT_ENABLED=true

# OAuth & Authentication
OAUTH_ENABLED=true
OAUTH_RBAC_ENABLED=true
OAUTH_METADATA_URL=""
OAUTH_API_APP_ID=""
OAUTH_API_APP_ID_URI=""
OAUTH_API_APP_SECRET=""
OAUTH_SWAGGER_APP_ID=""
OAUTH_UI_APP_ID=""

# Pagination Settings
DEFAULT_PAGE_NUMBER=1
DEFAULT_PAGE_SIZE=10
DEFAULT_HEADER_PAGE_SIZE=10
DEFAULT_FILTER_OPERATOR="and"
MAX_PAGE_SIZE=1000
PAGE_SIZE_100=100

# Performance
SLOW_QUERY_DURATION=1

# Tracing & Monitoring
UVICORN_LOG_CONFIG="logging-azure.yaml"
TRACEBACK_MAX_ENTRIES=15
TRACING_ENABLED=true
TRACING_METRICS_HEADER=false
TRACE_REQUEST_BODY=false
TRACE_REQUEST_BODY_MIN_STATUS_CODE=400
TRACE_REQUEST_BODY_TRUNCATE_BYTES=2048
TRACE_QUERY_MAX_LEN=4000
APPLICATIONINSIGHTS_CONNECTION_STRING="InstrumentationKey=00000000-0000-0000-0000-000000000000"
# To enable tracing to Zipkin, setting of ZIPKIN_HOST is required
ZIPKIN_HOST=localhost
ZIPKIN_PORT=9411
ZIPKIN_ENDPOINT=/api/v2/spans
ZIPKIN_PROTOCOL=http

# Testing & Schemathesis
SCHEMATHESIS_STUDY_UID=Study_000006
SCHEMATHESIS_HOOKS="clinical_mdr_api.hooks.schemathesis_hooks"

# Third-party Integrations
MS_GRAPH_INTEGRATION_ENABLED=true
MS_GRAPH_GROUPS_QUERY="\$filter=startsWith(displayName, 'OpenStudyBuilder')"

# API Base URLs
API_BASE_URL="http://localhost:8000"

# gzip API responses (Content-Encoding: gzip)
GZIP_RESPONSE_MIN_SIZE=1000
GZIP_LEVEL=5
