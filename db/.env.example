NEO4J_MDR_HTTP_PORT=5074
NEO4J_MDR_BOLT_PORT=5078
NEO4J_MDR_HTTPS_PORT=443
NEO4J_MDR_HOST=localhost
NEO4J_MDR_AUTH_USER=neo4j
NEO4J_MDR_AUTH_PASSWORD=Abcd-1234
NEO4J_MDR_DATABASE=neo4j
NEO4J_MDR_CLEAR_DATABASE=false
NEO4J_MDR_BACKUP_DATABASE=false

# Set these if you want the API to connect with less-privileged users
# Instead of the default admin neo4j user
# This is defense in depth, and the API will still work with the default admin user,
# but it is recommended to use a less-privileged user for production deployments.
# NEO4J_MDR_ROLE_USER=mdr_user
# NEO4J_MDR_ROLE_PASSWORD=Efgh-1234
# NEO4J_STAGING_ROLE_USER=staging_user
# NEO4J_STAGING_ROLE_PASSWORD=Xyzz-1234

# If you run neo4j desktop, the defaults ports are
# ```
# NEO4J_MDR_HTTP_PORT=7474
# NEO4J_MDR_BOLT_PORT=7687