    <node id="n8">
      <data key="d6">
        <y:ShapeNode>
          <y:Geometry height="250.7802723596412" width="285.32537326022907" x="710.4689502972707" y="-1.9407166413356407"/>
          <y:Fill color="#FFCC00" transparent="false"/>
