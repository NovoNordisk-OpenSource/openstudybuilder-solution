# Local-dev only. Copy to `.env` and fill in NEO4J_PASSWORD with any value;
# the database container will be created with that password and the api
# container reads it via NEO4J_DSN. `.env` is gitignored.
NEO4J_PASSWORD=<your-password>
NEO4J_USER=neo4j

# DATABASE_URL is consumed by the test suite (migrations/utils, data_corrections/utils).
# Substitute the same NEO4J_PASSWORD value, e.g.
#   DATABASE_URL=bolt://neo4j:${NEO4J_PASSWORD}@localhost:7687
# python-dotenv does NOT expand ${...} in values, so write the literal here
# matching what you set above.
DATABASE_URL=bolt://neo4j:<your-password>@localhost:7687
DATABASE_NAME=schema.migration.test
API_BASE_URL=http://localhost:8000
CREATE_DB=true

# Migration CT Import only: the CDISC staging database that is merged into DATABASE_NAME.
# STAGING_DATABASE_URL is optional (defaults to DATABASE_URL, i.e. same server).
STAGING_DATABASE_NAME=schema.migration.test.staging
# STAGING_DATABASE_URL=bolt://neo4j:<your-password>@localhost:7687

# API auth. Leave all unset for a local API without auth. Otherwise, first
# match wins:
#   STUDYBUILDER_API_TOKEN                          -> that bearer token, verbatim
#   CLIENT_ID + CLIENT_SECRET + TOKEN_ENDPOINT + SCOPE -> client credentials
#   CLIENT_ID + AUTH_ENDPOINT + TOKEN_ENDPOINT + SCOPE -> browser login (SSO),
#     redirect on http://localhost:5000/; add offline_access to SCOPE for runs
#     longer than the ~60 min token lifetime
# STUDYBUILDER_API_TOKEN=
# CLIENT_ID=
# CLIENT_SECRET=
# AUTH_ENDPOINT=
# TOKEN_ENDPOINT=
# SCOPE=

MDR_MIGRATION_ACTIVE_SUBSTANCES=migration_data/datafiles/compounds/active_substances.json
MDR_MIGRATION_PHARMACEUTICAL_PRODUCTS=migration_data/datafiles/compounds/pharmaceutical_products.json
MDR_MIGRATION_MEDICINAL_PRODUCTS=migration_data/datafiles/compounds/medicinal_products.json
MDR_MIGRATION_COMPOUNDS=migration_data/datafiles/compounds/compounds.json
MDR_MIGRATION_ODM_ITEMS=migration_data/datafiles/libraries/concepts/crfs/odm_items.csv