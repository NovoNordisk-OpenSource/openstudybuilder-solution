VITE_ENABLE_DEMO_BACKEND=true

# Path to the API OpenAPI spec used to generate mock responses.
# Absolute paths or paths relative to the frontend/ dir are accepted.
# Default (when unset): ../api/openapi.json (the in-repo spec).
# Override this only to follow a spec that's ahead of the committed one.
# VITE_OPENAPI_SPEC=../api/openapi.json

# Auto-login bypass for the demo sign-in picker. Comma-separated role list, or
# `*` / `all` for every role. Useful for E2E tests and for working with a fixed
# identity. When unset (default), the user must pick roles via the Login page.
# VITE_DEMO_AUTH_ROLES=Library.Read,Library.Write,Study.Read,Study.Write,Admin.Read
# VITE_DEMO_AUTH_NAME=Demo User
