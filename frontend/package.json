{
  "name": "studybuilder",
  "version": "2.2.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "dev:demo": "vite --mode demo",
    "build": "vite build",
    "build:dev": "vite build --mode dev",
    "build:staging": "vite build --mode staging",
    "build:demo": "vite build --mode demo",
    "preview": "vite preview",
    "preview:demo": "vite preview --mode demo",
    "test:smoke": "VITE_DEMO_AUTH_ROLES=* VITE_DEMO_AUTH_NAME='Smoke Tester' npm run build:demo && playwright test --config tests/smoke/playwright.config.js",
    "test:smoke:headed": "VITE_DEMO_AUTH_ROLES=* VITE_DEMO_AUTH_NAME='Smoke Tester' npm run build:demo && playwright test --config tests/smoke/playwright.config.js --headed",
    "test:smoke:ui": "playwright test --config tests/smoke/playwright.config.js --ui",
    "test:fixtures": "node --test tests/fixtures/*.test.mjs",
    "lint": "eslint . --ext .vue,.js --fix",
    "lint:staged": "eslint --fix",
    "format": "prettier --write .",
    "format:staged": "prettier --write",
    "update-config": "cat public/config.json | scripts/update-config.awk | tee public/config.json",
    "i18n:report": "vue-cli-service i18n:report --src './src/**/*.?(js|vue)' --locales './src/locales/**/*.json'",
    "prepare": "husky",
    "build-sbom": "python3 ../_tools/build_sbom.py --npm --fallback-dir doc/licenses --level 2 --output sbom.md"
  },
  "dependencies": {
    "@fontsource-variable/open-sans": "^5.3.0",
    "@formkit/drag-and-drop": "^0.5.3",
    "@microsoft/applicationinsights-clickanalytics-js": "^3.2.0",
    "@microsoft/applicationinsights-web": "^3.2.0",
    "@vueup/vue-quill": "^1.2.0",
    "axios": "^1.17.0",
    "buffer": "^6.0.3",
    "chart.js": "^4.4.0",
    "dompurify": "^3.4.12",
    "html2canvas": "^1.4.1",
    "lodash": "^4.18.1",
    "luxon": "^3.4.4",
    "marked": "^10.0.0",
    "oidc-client-ts": "^3.0.0-beta.0",
    "pinia": "^2.1.7",
    "quill": "2.0.2",
    "quill-table-better": "^1.2.3",
    "tslib": "^2.8.1",
    "vue": "^3.4.19",
    "vue-chartjs": "^5.2.0",
    "vue-i18n": "11.1.10",
    "vue-router": "^4.2.5",
    "vuetify": "4.0.2",
    "write-excel-file": "^4.1.1",
    "yaml": "^2.8.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@mdi/font": "^7.3.67",
    "@playwright/test": "^1.62.1",
    "@vitejs/plugin-vue": "^6.0.7",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.8.0",
    "husky": "^9.1.7",
    "prettier": "^3.2.5",
    "sass": "^1.99.0",
    "sass-embedded": "^1.86.0",
    "vite": "^8.0.16",
    "vite-plugin-vuetify": "^2.1.3"
  },
  "overrides": {
    "js-yaml": "4.3.0",
    "quill": "2.0.2",
    "immutable": "^5.1.9",
    "flatted": "^3.4.2",
    "picomatch": "^4.0.4",
    "lodash": "^4.18.1",
    "lodash-es": "^4.18.1"
  }
}
